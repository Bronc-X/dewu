# Local paths
APP_DATA_DIR=data
BACKGROUND_DIR=assets/backgrounds

# External API configuration.
# Third-party providers do not mock success: if selected but not configured,
# the backend returns a clear provider configuration error.
# If you use OpenAI-compatible vision/image APIs, filling OPENAI_API_KEY is enough
# for the default vision/image clients.
OPENAI_API_KEY=
VISION_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-1.5
IMAGE_QUALITY=medium

# Optional OpenAI-compatible overrides.
VISION_API_BASE_URL=
VISION_API_KEY=
IMAGE_API_BASE_URL=
IMAGE_API_KEY=

# Provider selection.
# local = existing in-house pipeline; photoroom/adobe_firefly/adobe_photoshop
# require real credentials.
MATTING_PROVIDER=local
COMPOSITING_PROVIDER=local
BACKGROUND_PROVIDER=local

# PhotoRoom API.
PHOTOROOM_API_KEY=
PHOTOROOM_SEGMENT_URL=https://sdk.photoroom.com/v1/segment
PHOTOROOM_EDIT_URL=https://image-api.photoroom.com/v2/edit
PHOTOROOM_AI_BACKGROUND_MODEL=

# Adobe Firefly / Photoshop API.
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_SCOPE=openid,AdobeID,session,additional_info,read_organizations,firefly_api,ff_apis
ADOBE_PHOTOSHOP_SCOPE=openid,AdobeID,read_organizations
ADOBE_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3
ADOBE_FIREFLY_BASE_URL=https://firefly-api.adobe.io
ADOBE_PHOTOSHOP_BASE_URL=https://image.adobe.io
ADOBE_JOB_POLL_ATTEMPTS=40
ADOBE_JOB_POLL_INTERVAL_SECONDS=3

# Processing defaults
MAX_IMAGES_PER_BATCH=8
MAX_RETRIES_PER_IMAGE=1
PROCESSING_LONG_EDGE=1800
PRODUCT_CHANGE_REVIEW_THRESHOLD=32
PRODUCT_CHANGE_FAIL_THRESHOLD=42
